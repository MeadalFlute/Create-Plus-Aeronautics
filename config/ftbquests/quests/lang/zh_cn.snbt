	quest.5B63C5D6D8BF040D.title: "4.3三维运输"
	quest.5B74744EE5D552DC.quest_desc: ["类似合成升级，不过随身带的需求不大"]
	quest.5B74744EE5D552DC.title: "O2.18有些用，但不多"
	quest.5B7CAF6382995374.quest_desc: ["来自《功能性存储》的压缩抽屉可以自动将物品压缩存储，且可以直接取出块、锭、粒&7（而不需要手动合成）&r，非常的方便"]
	quest.5B7CAF6382995374.title: "S2.10.2更方便的选择"
