	quest.02ABE04F668CD001.title: "信息汇总"
	quest.02AC24E1D7921EB0.quest_desc: [
		"游玩过程中，偶尔会有字体&e&l重影&r，这是&eMCsans+&r资源包导致的。"
		""
		"解决方法&e二选一&r："
		""
		"①在&e设置…&r/&e资源包…&r中卸载&eMCsans+&r"
		""
		"②额外下载模组[&e现代化UI&r]&eModernUI&r，代价是少部分文字显示会略微错位。"
	]
	quest.02AC24E1D7921EB0.title: "字体"
	quest.02DB3C1ECE2179FD.quest_desc: ["精妙背包可以通过安装升级模块获得更多功能，这里列一些比较实用的"]
	quest.02DB3C1ECE2179FD.title: "O2.11插件"
