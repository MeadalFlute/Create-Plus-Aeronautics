	]
	quest.6BCAC18D81E9476D.title: "How to Play with Create?"
	quest.6BE2FADB6BBB8E57.quest_desc: [
		"Item vaults can store a large number of items and are very suitable for storage"
		""
		"Although it cannot be opened directly, there are always more solutions than difficulties."
		""
		"{\"text\":\"For example, attach a terminal to it\",\"underlined\":true,\"color\":\"blue\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"376B0226F9435FAD\"}}"
