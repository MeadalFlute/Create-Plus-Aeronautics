	quest.6C3FDDA6C2D1E84D.title: "O3.16 Collect Dropped Items"
	quest.6C446DC45D0EFE73.quest_desc: [
		"Smashing enough mass into the overpressure device will produce neutron bomb &8 (a minute of silence for the iron golem) &r"
