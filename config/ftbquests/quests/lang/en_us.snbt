	quest.74B83B6A3D5C8C4D.title: "HS5.4.3.2 Does Require Raw Ore?"
	quest.7503562CA4582ABC.quest_desc: ["Using factory instruments, minerals in the storage network can be automatically crushed"]
	quest.750CB599AAC54B5C.quest_desc: [
		"Although nether rock is everywhere, it is not renewable and requires you to collect it everywhere."
		""
		"Using factory instruments to control production may reduce your work stress"
