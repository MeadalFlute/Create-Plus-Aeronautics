	quest.6C975F30267C6C34.quest_desc: ["Used with cables to connect remote containers to the storage network"]
	quest.6C975F30267C6C34.title: "O4.13 Installation Interface"
	quest.6CA92EBEC0822090.quest_desc: [
		"Honey is the secret treasure for increasing mineral production and can increase efficiency hundreds of times."
		""
