	quest.27F40A9EF4C57BD7.title: "AC1.23.1 I Think I Can Do It"
	quest.285BF1D72C2DE4F8.quest_desc: [
		"&e andesite alloy &r changed the world. This magical and cheap material is very suitable for transmission. It is the cornerstone of Create."
		""
		"&aTips:&fClick on the item in the mission target to view how to obtain it."
		""
