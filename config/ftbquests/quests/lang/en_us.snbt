	quest.3A2AF3E7B6EFE074.title: "HS5.2.3.2 Profanity"
	quest.3A434C665E7F627A.quest_desc: ["It is also not recommended to do"]
	quest.3A434C665E7F627A.title: "O2.20 Don’t Make It Either"
	quest.3A4783866AF0E954.quest_desc: ["Tired of cranking like a nigga? Try the water wheel now, 100% clean unlimited energy"]
	quest.3A4783866AF0E954.title: "S1.6.1 Hydraulic…stress"
	quest.3AC7DED6E715F8EC.quest_desc: [
		"Hover over the Mechanical Press, then hold &e[W]&r to Ponder it. After watching the scene, you should know how to use it."
		""
		"&aTips&r: This task can turn pages"
		"{@pagebreak}"
		"If you have trouble transferring stress, you can read this section:"
