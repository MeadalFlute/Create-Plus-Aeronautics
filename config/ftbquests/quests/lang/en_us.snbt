	quest.6DE014274FF80AB5.title: "H5.4.1 Preconditions"
	quest.6E069D46FB4B2F5E.quest_desc: [
		"Installing the &e downward-facing sail &r on the body can provide additional downforce when driving at high speeds and theoretically provide a firmer grip."
		""
		"But if there is really a need for high-speed driving, it would be better to build a road."
		""
		"Warm reminder: Driving too fast off-road can easily cause motion sickness/rollover."
		""
		"&7Or use the train?"
	]
	quest.6E069D46FB4B2F5E.title: "Grip"
	quest.6E0DCE334B9D44B4.quest_desc: ["If you have a basic knowledge of redstone, you can explore the combination of dynamic structures and redstone by yourself :P"]
	quest.6E0DCE334B9D44B4.title: "S1.7.14 I Think I Can Do It"
	quest.6E68235AA84E758D.quest_desc: [
		"Many times, you will want to control the speed of the &e power source &7 (tyres, propellers, etc.) &r. This is exactly the purpose for which the analog actuator was invented."
