	quest.385E701E2A01ECC8.title: "AC1.6.5 Iron Brushing Machine"
	quest.3906FBFE6DF806E4.quest_desc: ["The dynamic structure here requires cache and interface, otherwise the power harvester cannot automatically collect wheat and seeds."]
	quest.3906FBFE6DF806E4.title: "H1.2 Wildcard"
	quest.390C138909D71BED.quest_desc: [
		"It can be used to draw in and out items from a designated direction, and can also be used for fluid drawers, which is very convenient."
		""
		"&aTips&f: Right-click these two upgrades in the backpack to change the specified direction. Press &eF3&r to check the direction you are facing."
	]
	quest.390C138909D71BED.title: "O3.15 Built-in Omnidirectional Funnel"
	quest.393AD5FF6F557EF0.quest_desc: ["Crush the blaze rod to get &7 more blaze powder than synthesizing &r"]
	quest.397A15088D9D7C59.quest_desc: [
		"When planting mushrooms on fertile soil, there is a chance of growing &e colonies &r after a period of time. Use &e scissors &r to harvest."
		""
		"You can &7 (when there are five caps) &r after the colony is completely mature &7 (when it has five caps) &r Left-click with scissors to harvest the entire colony &7 (5 mushrooms will drop if you do not use scissors) &r, right-click to harvest a single mushroom and reduce one layer of caps &7 (leave at least two caps) &r."
		""
		"Colonies can be ripened with bone meal. But be careful, you must wait until the mushrooms become &e colony &r before using bone meal to ripen them, otherwise, directly ripening the mushrooms will produce giant mushrooms."
		""
		"Bacteria colonies can speed up the process of turning organic fertilizer into fertile soil."
	]
	quest.397A15088D9D7C59.quest_subtitle: "Steve picking mushrooms, carrying a big basket"
	quest.397A15088D9D7C59.title: "F1.8 Kinds of Mushrooms"
	quest.39D1FAC09600EFD3.quest_desc: [
		"Not only can cardboard be used as a baler, it can also be used as armor and weapons."
		""
		"After collecting all the cardboard armor sets, sneak &7 (crouch down) and &r have special effects."
	]
	quest.39D1FAC09600EFD3.title: "S2.16.6 Cardboard"
	quest.39E11B52BE65F6B5.quest_desc: ["After the villager binds the jewelry processing table as a work block, he will become a full-time jeweler. You need to buy the royal steel forging template from him."]
	quest.39E11B52BE65F6B5.title: "AC1.11 Jeweler"
	quest.3A2AF3E7B6EFE074.quest_desc: [
		"Tell me how to inject chocolate into dumplings?"
