//setblock -205 -3 -301 minecraft:trial_spawner[ominous=false,trial_spawner_state=waiting_for_players]
{
normal_config:{
    // 未指定loot_tables_to_eject时，默认调用原版普通掉落表
    simultaneous_mobs:1.0f, // 基础同时生成物数量
    simultaneous_mobs_added_per_player:0.5f, // 每个玩家额外增加的同时生成物数量
    spawn_potentials:[  // 常规生成物池子
        {data:{entity:{id:"minecraft:breeze"}},weight:1}
    ],
    ticks_between_spawn:20, // 生成间隔
    total_mobs:2.0f,    // 基础生成物总量
    total_mobs_added_per_player:1.0f    // 每个玩家额外增加的生成物总量
    },
ominous_config:{
    loot_tables_to_eject:[  // 不祥掉落表
        {data:"minecraft:spawners/ominous/trial_chamber/key",weight:3},
        {data:"minecraft:spawners/ominous/trial_chamber/consumables",weight:7}
    ],
    simultaneous_mobs_added_per_player:0.5f,    // 每个玩家额外增加的同时生成物数量
    spawn_potentials:[  // 不祥生成物池子
        {data:{entity:{id:"minecraft:breeze"}},weight:1}
    ],
    ticks_between_spawn:20, // 生成间隔
    total_mobs:4.0f,        // 基础生成物总量
    total_mobs_added_per_player:1.0f    // 每个玩家额外增加的生成物总量
},
spawn_data:{    // 生成物缓存
    entity:{id:"minecraft:breeze"}
}
}


